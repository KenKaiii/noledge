# noledge environment configuration. Copy to `.env.local` and edit.
# Everything here is OPTIONAL — the app runs with none of it set.

# ---------------------------------------------------------------------------
# Provider API keys (alternative to entering them in the UI). A provider whose
# key is absent is simply hidden from the model picker.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# GLM_API_KEY=
# MINIMAX_API_KEY=
# XIAOMI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# OCR (document image extraction)
# ---------------------------------------------------------------------------
# OCR_ENABLED=true
# OCR_LANGUAGE=eng

# ---------------------------------------------------------------------------
# Security (see SECURITY.md)
# ---------------------------------------------------------------------------
# Require a password before the app can be used. Leave UNSET for the default
# open/localhost-only experience. Set it before exposing noledge on a LAN,
# server, or tunnel. When set, all pages and API routes require a session.
# NOLEDGE_PASSWORD=

# Secret used to (a) encrypt provider keys + OAuth tokens at rest and (b) sign
# session cookies. If unset, secrets are stored in plaintext (legacy behavior)
# and cookies are signed with NOLEDGE_PASSWORD. Set a long random value, e.g.
# `openssl rand -hex 32`. Changing it invalidates stored secrets and sessions.
# NOLEDGE_SECRET=

# Set to "true" only when serving over HTTPS, so the session cookie is marked
# Secure. Leave unset for plain-HTTP LAN access or the cookie won't be sent.
# NOLEDGE_COOKIE_SECURE=false

# Optional outbound proxy for YouTube transcript fetches (bypasses IP rate
# limits). Note: SOCKS5 proxies are affected by the patched undici CVE — keep
# undici up to date.
# HTTPS_PROXY=
# HTTP_PROXY=

# Custom database path (defaults to ./.data/noledge.db)
# NOLEDGE_DB_PATH=
